# ============================================================
# Environment PRODUCTION — CBT SMA Kartika III-1 Banyubiru
# Hostinger Shared Hosting — SPLIT DOMAIN
# ------------------------------------------------------------
# Backend  (API + Filament admin): https://ipcbtkartika.koomit.com
# Frontend (SPA siswa)          : https://cbtkatika.koomit.com
#
# Cara pakai: copy file ini menjadi `.env` di server (jangan
# upload .env lokal dari komputer!). Lalu jalankan:
#   php artisan key:generate
# ============================================================

APP_NAME="CBT SMA Kartika III-1 Banyubiru"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Backend domain (hosting Laravel / Filament / API)
APP_URL=https://ipcbtkartika.koomit.com

# Frontend domain (SPA siswa yang konsumsi /api)
FRONTEND_URL=https://cbtkatika.koomit.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ------------------------------------------------------------
# DATABASE — MySQL dari hPanel Hostinger (buat dulu di hPanel:
# Website → Databases → MySQL Databases)
# ------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=u<USERNAME>_cbt_kartika
DB_USERNAME=u<USERNAME>_cbt
DB_PASSWORD=GANTI_DENGAN_PASSWORD_KUAT

# ------------------------------------------------------------
# SESSION & CACHE
# Split domain memakai cookie session global (shared) yang bisa
# dibaca frontend & backend. SameSite=None harus diaktifkan agar
# cookie dikirim lintas domain, dan pastikan HTTPS aktif.
# ------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# .koomit.com agar cookie dikenali semua subdomain (frontend & backend).
SESSION_DOMAIN=.koomit.com
# Cross-origin cookie WAJIB SameSite=None + Secure (HTTPS).
SESSION_SAME_SITE=none
SESSION_SECURE_COOKIE=true

CACHE_STORE=file
CACHE_PREFIX=

# ------------------------------------------------------------
# QUEUE — shared hosting TIDAK punya worker jalan terus.
# Pilihan: 'sync' (langsung) atau 'database' (antri; butuh cron
# `php artisan queue:work --once` tiap menit). Default: sync.
# ------------------------------------------------------------
QUEUE_CONNECTION=sync

# ------------------------------------------------------------
# BROADCAST / REALTIME MONITORING — Pusher
# Daftar gratis di https://pusher.com (sandbox free tier).
# Isi APP_ID, KEY, SECRET dari dashboard Pusher, lalu
# deploy ulang .env.production.example ini ke server.
# VITE_PUSHER_* dipakai oleh frontend JS untuk koneksi realtime.
# ------------------------------------------------------------
BROADCAST_CONNECTION=pusher
BROADCAST_DRIVER=pusher

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=api-mt1.pusher.com
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=ap1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# ------------------------------------------------------------
# CORS & SANCTUM — izinkan frontend domain mengakses API backend
# ------------------------------------------------------------
CORS_ALLOWED_ORIGINS="${FRONTEND_URL}"
SANCTUM_STATEFUL_DOMAINS="${FRONTEND_URL},${APP_URL}"

# ------------------------------------------------------------
# MAIL — gunakan SMTP Hostinger (hPanel: Email → Email Accounts)
# ------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=admin@smakkartika31.sch.id
MAIL_PASSWORD=GANTI_DENGAN_PASSWORD_EMAIL
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=admin@smakkartika31.sch.id
MAIL_FROM_NAME="${APP_NAME}"

# ------------------------------------------------------------
# FILESYSTEM
# ------------------------------------------------------------
FILESYSTEM_DISK=local

# ------------------------------------------------------------
# MISC
# ------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
